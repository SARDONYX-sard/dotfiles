{
  "[gitconfig]": {
    "editor.semanticHighlighting.enabled": true
  },
  "[lua]": {
    "editor.defaultFormatter": "sumneko.lua"
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "editor.rulers": [100],
  "files.associations": {
    ".editorconfig": "properties",
    ".envpath": "shellscript",
    ".gitconfig": "gitconfig",
    ".gitignore": "ignore",
    "*.json": "jsonc",
    "*.txt": "txt",
    "*.vim": "viml",
    "**/home/git/config": "gitconfig",
    "**/home/git/config.local.example": "gitconfig",
    "**/home/git/config.local": "gitconfig",
    "**/home/git/ignore": "ignore",
    "**/shell/bash/bashrc": "shellscript",
    "**/shell/bash/inputrc": "properties",
    "git-config.txt": "gitconfig",
    "LICENSE": "txt"
  },
  "files.exclude": {
    "**/__pycache__": true,
    "**/.idea": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.idea": true,
    "**/.mypy_cache": true,
    "**/.venv": true
  },
  "Lua.codeLens.enable": true,
  "Lua.hint.enable": true,
  "Lua.hint.setType": true,
  "python.envFile": "${workspaceFolder}/.env",
  "toml.formatter.alignEntries": true
}
